    "last_step": {
      "type": "int",
      "default": 1,
      "description": "上一步骤"
    },
    "line1_data": {
      "type": "float",
      "default": 0,
      "description": "第1行数据"
    },
    "line2_data": {
      "type": "float",
      "default": 0,
      "description": "第2行数据"
    },
    "line3_data": {
      "type": "float",
      "default": 0,
      "description": "第3行数据"
    },
    "line4_data": {
      "type": "float",
      "default": 0,
      "description": "第4行数据"
    },
    "max_data": {
      "type": "float",
      "default": -1,
      "description": "连续测量最大值"
    },
    "min_data": {
      "type": "float",
      "default": -1,
      "description": "连续测量最小值"
    },
    "laser_on": {
      "type": "bool",
      "default": false,
      "description": "激光状态"
    },
    "continuous_flag": {
      "type": "bool",
      "default": false,
      "description": "连续测量标志"
    },
    "backlight_on": {
      "type": "bool",
      "default": true,
      "description": "背光状态"
    },
    "beep_enable": {
      "type": "bool",
      "default": true,
      "description": "蜂鸣器开关"
    },
    "base_back": {
      "type": "bool",
      "default": true,
      "description": "后基准(true)/前基准(false)"
    },
    "unit": {
      "type": "int",
      "default": 1,
      "description": "单位: 0=m, 1=ft, 2=in"
    },
    "measure_mode": {
      "type": "int",
      "default": 0,
      "description": "测量模式"
    },
    "error_code": {
      "type": "int",
      "default": 0,
      "description": "错误码"
    },
    "distance": {
      "type": "float",
      "default": 0,
      "description": "当前测量距离"
    },
    "idle_time": {
      "type": "int",
      "default": 0,
      "description": "空闲计时(秒)"
    }
  },
  "eventCategories": {
