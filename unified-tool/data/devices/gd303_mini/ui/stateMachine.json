{
  "device": "gd303_mini",
  "name": "GD303-MINI 完整状态机",
  "version": "3.1",
  "description": "GD303-MINI激光测距仪完整UI状态机 - 包含开机流程、所有测量模式、自动超时",
  "saveTime": "2025-12-31T10:00:00.000Z",
  "variables": {
    "runstep": {
      "type": "int",
      "default": 1,
      "description": "当前步骤 (奇数=等待, 偶数=结果)"
