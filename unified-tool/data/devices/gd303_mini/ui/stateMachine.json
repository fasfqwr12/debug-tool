      "label": "按键事件",
      "color": "#3b82f6"
    },
    "measure": {
      "label": "测量事件",
      "color": "#22c55e"
    },
    "system": {
      "label": "系统事件",
      "color": "#ef4444"
    },
    "timer": {
      "label": "定时器事件",
      "color": "#f59e0b"
    }
  },
  "events": {
    "K1_SHORT": {
      "category": "key",
      "label": "K1短按",
      "description": "测量键短按"
    },
    "K1_LONG": {
      "category": "key",
      "label": "K1长按",
      "description": "长按进入连续测量"
    },
    "K1_RELEASE": {
      "category": "key",
      "label": "K1松开",
      "description": "测量键松开"
    },
    "K1_XLONG": {
      "category": "key",
      "label": "K1超长按",
      "description": "超长按开机(1.1秒)"
    },
    "K2_SHORT": {
      "category": "key",
      "label": "K2短按",
      "description": "模式键短按"
    },
    "K2_LONG": {
      "category": "key",
      "label": "K2长按",
      "description": "长按切换基准"
    },
    "K3_SHORT": {
      "category": "key",
      "label": "K3短按",
      "description": "清除键短按"
    },
    "K3_LONG": {
      "category": "key",
      "label": "K3长按",
      "description": "长按背光开关"
    },
    "K3_XLONG": {
      "category": "key",
      "label": "K3超长按",
      "description": "超长按关机(3秒)"
    },
    "K1K2_COMBO": {
      "category": "key",
      "label": "K1+K2组合",
      "description": "蜂鸣器开关"
    },
    "MEASURE_OK": {
      "category": "measure",
      "label": "测距成功"
    },
    "MEASURE_FAIL": {
      "category": "measure",
      "label": "测距失败"
    },
    "TIMEOUT_1S": {
      "category": "timer",
      "label": "1秒超时",
      "description": "单位切换定时"
    },
    "TIMEOUT": {
      "category": "timer",
      "label": "通用超时",
      "description": "状态内部超时事件"
    },
    "TIMEOUT_LASER": {
      "category": "timer",
      "label": "激光超时",
      "description": "15秒"
    },
    "TIMEOUT_BACKLIGHT": {
      "category": "timer",
      "label": "背光超时",
      "description": "30秒"
    },
    "TIMEOUT_POWER": {
      "category": "timer",
      "label": "关机超时",
      "description": "60秒"
    }
  },
  "hierarchy": {
    "ROOT": {
      "id": "ROOT",
      "label": "系统",
      "type": "compound",
      "level": 0,
      "initial": "OFF",
      "description": "GD303-MINI系统根状态",
      "children": {
        "OFF": {
          "id": "OFF",
          "label": "关机",
          "type": "atomic",
          "level": 1,
          "description": "设备关机状态，LCD全灭，等待K1超长按开机",
          "entryActions": [
            "lcd:clearAll",
            "comp:setVisible:laser:false",
            "hw:backlight:off",
            "assign:backlight_on = false",
            "assign:idle_time = 0"
          ],
          "exitActions": [],
          "display": {
            "lcdOff": true
          }
        },
        "BOOT": {
          "id": "BOOT",
          "label": "开机流程",
          "type": "compound",
          "level": 1,
          "initial": "FULL_DISPLAY",
          "description": "开机初始化和单位选择: 全显→延时→清屏→初始界面",
          "children": {
            "FULL_DISPLAY": {
              "id": "FULL_DISPLAY",
              "label": "全显",
              "type": "atomic",
              "level": 2,
              "description": "开机全显测试，500ms后自动进入初始化",
              "entryActions": [
                "hw:backlight:on",
                "lcd:showAll",
                "assign:backlight_on = true",
                "timeout:500"
              ],
              "exitActions": [
                "lcd:clearAll"
              ],
              "display": {
                "action": "lcd:showAll",
                "expects": [
                  "LCD全显",
                  "500ms后自动清屏"
                ]
              }
            },
            "INIT": {
              "id": "INIT",
              "label": "初始化",
              "type": "atomic",
              "level": 2,
              "description": "硬件初始化，显示初始界面",
              "entryActions": [
                "preset:boot_init",
                "assign:idle_time = 0"
              ],
              "display": {
                "preset": "boot_init",
                "expects": [
                  "Line4=-----",
                  "单位显示",
                  "后基准关闭"
                ]
              }
            },
            "UNIT_SELECT": {
              "id": "UNIT_SELECT",
              "label": "单位选择",
              "type": "atomic",
              "level": 2,
              "description": "K1持续按住时，每1秒自动切换单位 m→ft→in→m，单位闪烁提示",
              "entryActions": [
                "preset:unit_select"
              ],
              "exitActions": [
                "anim:unitSelectAnim:stop"
              ],
              "display": {
                "preset": "unit_select",
                "expects": [
                  "单位闪烁",
                  "每秒切换: m→ft→in→m"
                ]
              }
            }
          },
          "display": {},
          "entryActions": [],
          "exitActions": []
        },
        "ON": {
          "id": "ON",
          "label": "运行",
          "type": "compound",
          "level": 1,
          "initial": "IDLE",
          "description": "设备运行状态",
          "entryActions": [
            "preset:boot_complete",
            "assign:idle_time = 0"
          ],
          "exitActions": [
            "comp:setVisible:laser:false",
            "anim:laserBlink:stop"
          ],
          "children": {
            "IDLE": {
              "id": "IDLE",
              "label": "待机",
              "type": "atomic",
              "level": 2,
              "description": "等待用户操作，激光关闭",
              "entryActions": [
                "comp:setVisible:laser:false",
                "anim:laserBlink:stop",
                "preset:single_idle"
              ],
              "display": {
                "preset": "single_idle",
                "expects": [
                  "激光关",
                  "Line4=-----或上次结果"
                ]
              }
            },
            "SINGLE": {
              "id": "SINGLE",
              "label": "单次测量",
              "type": "compound",
              "level": 2,
              "initial": "LASER_ON",
              "description": "单次测量流程，支持历史数据滚动",
              "entryActions": [
                "assign:measure_mode = 0"
              ],
              "children": {
                "LASER_ON": {
                  "id": "LASER_ON",
                  "label": "激光开启",
                  "type": "atomic",
                  "level": 3,
                  "description": "激光开启等待测量，15秒超时自动关闭",
                  "entryActions": [
                    "comp:setVisible:laser:true",
                    "anim:laserBlink:start",
                    "if:runstep % 2 == 0 then inc:runstep",
                    "if:runstep > last_step then scroll:history",
                    "comp:showPreset:Line4:dash",
                    "assign:idle_time = 0"
                  ],
                  "exitActions": [
                    "assign:last_step = runstep"
                  ],
                  "display": {
                    "preset": "single_laser_on",
                    "expects": [
                      "激光闪烁",
                      "Line4=-----"
                    ]
                  }
                },
                "RANGING": {
                  "id": "RANGING",
                  "label": "测距中",
                  "type": "atomic",
                  "level": 3,
                  "description": "正在执行测距",
                  "entryActions": [
                    "anim:measuringDots:start"
                  ],
                  "exitActions": [
                    "anim:measuringDots:stop"
                  ],
                  "display": {
                    "expects": [
                      "测距动画"
                    ]
                  }
                },
                "RESULT": {
                  "id": "RESULT",
                  "label": "显示结果",
                  "type": "atomic",
                  "level": 3,
                  "description": "显示测量结果，激光关闭",
                  "entryActions": [
                    "inc:runstep",
                    "assign:line4_data = distance",
                    "comp:setVisible:laser:false",
                    "anim:laserBlink:stop",
                    "hw:beep:short",
                    "comp:setValue:Line4:${line4_data}",
                    "assign:idle_time = 0"
                  ],
                  "display": {
                    "preset": "single_result",
                    "expects": [
                      "Line4=测量值",
                      "激光关"
                    ]
                  }
                },
                "ERROR": {
                  "id": "ERROR",
                  "label": "错误",
                  "type": "atomic",
                  "level": 3,
                  "description": "测量失败，显示错误码",
                  "entryActions": [
                    "comp:setVisible:laser:false",
                    "anim:laserBlink:stop",
                    "hw:beep:long",
                    "preset:error_display",
                    "anim:errorFlash:start"
                  ],
                  "exitActions": [
                    "anim:errorFlash:stop"
                  ],
                  "display": {
                    "preset": "error_display",
                    "expects": [
                      "Line4=NULLx"
                    ]
                  }
                }
              }
            },
            "AREA": {
              "id": "AREA",
              "label": "面积测量",
              "type": "compound",
              "level": 2,
              "initial": "AREA_INIT",
              "description": "面积测量(2步): 长×宽",
              "flowType": "multi",
              "totalSteps": 4,
              "entryActions": [
                "assign:measure_mode = 1",
                "flow:setType:multi",
                "flow:clearSlots",
                "preset:area_idle"
              ],
              "children": {
                "AREA_INIT": {
                  "id": "AREA_INIT",
                  "label": "面积初始",
                  "type": "atomic",
                  "level": 3,
                  "isReady": false,
                  "stepIndex": 0,
                  "description": "显示面积模式图标，等待开始",
                  "entryActions": [
                    "preset:area_idle"
                  ],
                  "display": {
                    "expects": [
                      "面积图标",
                      "Line3=-----",
                      "Line4=-----"
                    ]
                  }
                },
                "AREA_STEP1": {
                  "id": "AREA_STEP1",
                  "label": "测量长度",
                  "type": "atomic",
                  "level": 3,
                  "isReady": true,
                  "stepIndex": 1,
                  "description": "面积测量第一步：测量长度 (准备状态)",
                  "entryActions": [
                    "flow:onEnterReady",
                    "anim:laserBlink:start",
                    "anim:areaSide1Blink:start",
                    "preset:area_step1"
                  ],
                  "exitActions": [
                    "anim:areaSide1Blink:stop"
                  ],
                  "display": {
                    "expects": [
                      "激光闪烁",
                      "长度边闪烁"
                    ]
                  }
                },
                "AREA_STEP1_DONE": {
                  "id": "AREA_STEP1_DONE",
                  "label": "长度完成",
                  "type": "atomic",
                  "level": 3,
                  "isReady": false,
                  "stepIndex": 2,
                  "description": "长度测量完成，等待继续",
                  "entryActions": [
                    "flow:storeSlot:1",
                    "preset:area_step1_done"
                  ],
                  "exitActions": [],
                  "display": {
                    "expects": [
                      "Line2=长度值"
                    ]
                  }
                },
                "AREA_STEP2": {
                  "id": "AREA_STEP2",
                  "label": "测量宽度",
                  "type": "atomic",
                  "level": 3,
                  "isReady": true,
                  "stepIndex": 3,
                  "description": "面积测量第二步：测量宽度 (准备状态)",
                  "entryActions": [
                    "flow:onEnterReady",
                    "anim:laserBlink:start",
                    "anim:areaSide2Blink:start"
                  ],
                  "exitActions": [
                    "anim:areaSide2Blink:stop"
                  ],
                  "display": {
                    "expects": [
                      "激光闪烁",
                      "宽度边闪烁"
                    ]
                  }
                },
                "AREA_RESULT": {
                  "id": "AREA_RESULT",
                  "label": "面积结果",
                  "type": "atomic",
                  "level": 3,
                  "isReady": false,
                  "stepIndex": 4,
                  "description": "显示面积计算结果",
                  "entryActions": [
                    "flow:storeSlot:2",
                    "flow:calcArea",
                    "anim:laserBlink:stop",
                    "preset:area_result"
                  ],
                  "display": {
                    "expects": [
                      "Line2=长",
                      "Line3=宽",
                      "Line4=面积"
                    ]
                  }
                }
              }
            },
            "VOLUME": {
              "id": "VOLUME",
              "label": "体积测量",
              "type": "compound",
              "level": 2,
              "initial": "VOL_INIT",
              "description": "体积测量(3步): 长×宽×高",
              "entryActions": [
                "assign:measure_mode = 2",
                "assign:runstep = 1",
                "preset:volume_idle"
              ],
              "children": {
                "VOL_INIT": {
                  "id": "VOL_INIT",
                  "label": "体积初始",
                  "type": "atomic",
                  "level": 3,
                  "entryActions": [
                    "preset:volume_idle"
                  ],
                  "display": {
                    "expects": [
                      "体积图标",
                      "Line1~3=-----"
                    ]
                  }
                },
                "VOL_STEP1": {
                  "id": "VOL_STEP1",
                  "label": "测量长度",
                  "type": "atomic",
                  "level": 3,
                  "entryActions": [
                    "anim:laserBlink:start",
                    "anim:volumeSide1Blink:start"
                  ],
                  "exitActions": [
                    "anim:volumeSide1Blink:stop"
                  ]
                },
                "VOL_STEP2": {
                  "id": "VOL_STEP2",
                  "label": "测量宽度",
                  "type": "atomic",
                  "level": 3,
                  "entryActions": [
                    "assign:line1_data = distance",
                    "comp:setValue:Line1:${line1_data}",
                    "anim:volumeSide2Blink:start"
                  ],
                  "exitActions": [
                    "anim:volumeSide2Blink:stop"
                  ]
                },
                "VOL_STEP3": {
                  "id": "VOL_STEP3",
                  "label": "测量高度",
                  "type": "atomic",
                  "level": 3,
                  "entryActions": [
                    "assign:line2_data = distance",
                    "comp:setValue:Line2:${line2_data}",
                    "anim:volumeSide3Blink:start"
                  ],
                  "exitActions": [
                    "anim:volumeSide3Blink:stop"
                  ]
                },
                "VOL_RESULT": {
                  "id": "VOL_RESULT",
                  "label": "体积结果",
                  "type": "atomic",
                  "level": 3,
                  "entryActions": [
                    "assign:line3_data = distance",
                    "calc:line4_data = line1_data * line2_data * line3_data",
                    "anim:laserBlink:stop",
                    "comp:setValue:Line3:${line3_data}",
                    "comp:setValue:Line4:${line4_data}"
                  ],
                  "display": {
                    "expects": [
                      "Line1=长",
                      "Line2=宽",
                      "Line3=高",
                      "Line4=体积"
                    ]
                  }
                }
              }
            },
            "PYTH1": {
              "id": "PYTH1",
              "label": "勾股1",
              "type": "compound",
              "level": 2,
              "initial": "P1_INIT",
              "description": "勾股1(2步): √(斜边²-直角边²)",
              "entryActions": [
                "assign:measure_mode = 3",
                "assign:runstep = 1"
              ],
              "children": {
                "P1_INIT": {
                  "id": "P1_INIT",
                  "label": "勾股1初始",
                  "type": "atomic",
                  "level": 3,
                  "entryActions": [
                    "preset:pyth_idle"
                  ],
                  "display": {
                    "expects": [
                      "勾股1图标"
                    ]
                  }
                },
                "P1_STEP1": {
                  "id": "P1_STEP1",
                  "label": "测量斜边",
                  "type": "atomic",
                  "level": 3,
                  "entryActions": [
                    "anim:laserBlink:start",
                    "anim:pythSide1Blink:start"
                  ],
                  "exitActions": [
                    "anim:pythSide1Blink:stop"
                  ]
                },
                "P1_STEP2": {
                  "id": "P1_STEP2",
                  "label": "测量直角边",
                  "type": "atomic",
                  "level": 3,
                  "entryActions": [
                    "assign:line1_data = distance",
                    "comp:setValue:Line1:${line1_data}",
                    "anim:pythSide2Blink:start"
                  ],
                  "exitActions": [
                    "anim:pythSide2Blink:stop"
                  ]
                },
                "P1_RESULT": {
                  "id": "P1_RESULT",
                  "label": "勾股1结果",
                  "type": "atomic",
                  "level": 3,
                  "entryActions": [
                    "assign:line2_data = distance",
                    "comp:setValue:Line2:${line2_data}",
                    "calc:line4_data = sqrt(line1_data^2 - line2_data^2)",
                    "anim:laserBlink:stop",
                    "comp:setValue:Line4:${line4_data}"
                  ],
                  "guard": "line1_data > line2_data",
                  "display": {
                    "expects": [
                      "Line4=计算结果"
                    ]
                  }
                },
                "P1_ERROR": {
                  "id": "P1_ERROR",
                  "label": "勾股1错误",
                  "type": "atomic",
                  "level": 3,
                  "description": "斜边≤直角边，逻辑错误",
                  "entryActions": [
                    "assign:error_code = 4",
                    "preset:error_display"
                  ],
                  "display": {
                    "expects": [
                      "Line4=NULL4"
                    ]
                  }
                }
              }
            },
            "PYTH2": {
              "id": "PYTH2",
              "label": "勾股2",
              "type": "compound",
              "level": 2,
              "initial": "P2_INIT",
              "description": "勾股2(3步): √(斜边1²-公共边²)+√(斜边2²-公共边²)",
              "entryActions": [
                "assign:measure_mode = 4",
                "assign:runstep = 1"
              ],
              "children": {
                "P2_INIT": {
                  "id": "P2_INIT",
                  "label": "勾股2初始",
                  "type": "atomic",
                  "level": 3
                },
                "P2_STEP1": {
                  "id": "P2_STEP1",
                  "label": "测量斜边1",
                  "type": "atomic",
                  "level": 3
                },
                "P2_STEP2": {
                  "id": "P2_STEP2",
                  "label": "测量公共边",
                  "type": "atomic",
                  "level": 3
                },
                "P2_STEP3": {
                  "id": "P2_STEP3",
                  "label": "测量斜边2",
                  "type": "atomic",
                  "level": 3
                },
                "P2_RESULT": {
                  "id": "P2_RESULT",
                  "label": "勾股2结果",
                  "type": "atomic",
                  "level": 3,
                  "entryActions": [
                    "assign:line3_data = distance",
                    "calc:line4_data = sqrt(line1_data^2 - line2_data^2) + sqrt(line3_data^2 - line2_data^2)",
                    "comp:setValue:Line4:${line4_data}"
                  ],
                  "guard": "line1_data > line2_data && line3_data > line2_data"
                }
              }
            },
            "PYTH3": {
              "id": "PYTH3",
              "label": "勾股3",
              "type": "compound",
              "level": 2,
              "initial": "P3_INIT",
              "description": "勾股3(3步): √(斜边1²-公共边²)-√(斜边2²-公共边²)",
              "entryActions": [
                "assign:measure_mode = 5",
                "assign:runstep = 1"
              ],
              "children": {
                "P3_INIT": {
                  "id": "P3_INIT",
                  "label": "勾股3初始",
                  "type": "atomic",
                  "level": 3
                },
                "P3_STEP1": {
                  "id": "P3_STEP1",
                  "label": "测量斜边1",
                  "type": "atomic",
                  "level": 3
                },
                "P3_STEP2": {
                  "id": "P3_STEP2",
                  "label": "测量公共边",
                  "type": "atomic",
                  "level": 3
                },
                "P3_STEP3": {
                  "id": "P3_STEP3",
                  "label": "测量斜边2",
                  "type": "atomic",
                  "level": 3
                },
                "P3_RESULT": {
                  "id": "P3_RESULT",
                  "label": "勾股3结果",
                  "type": "atomic",
                  "level": 3,
                  "entryActions": [
                    "assign:line3_data = distance",
                    "calc:line4_data = sqrt(line1_data^2 - line2_data^2) - sqrt(line3_data^2 - line2_data^2)",
                    "comp:setValue:Line4:${line4_data}"
                  ],
                  "guard": "line2_data < line1_data && line3_data < line1_data && line2_data < line3_data"
                }
              }
            },
            "CONTINUOUS": {
              "id": "CONTINUOUS",
              "label": "连续测量",
              "type": "compound",
              "level": 2,
              "initial": "CONT_INIT",
              "description": "连续测量模式，显示MAX/MIN/当前值",
              "entryActions": [
                "assign:continuous_flag = true",
                "assign:max_data = -1",
                "assign:min_data = -1",
                "preset:continuous_idle"
              ],
              "exitActions": [
                "assign:continuous_flag = false",
                "anim:laserBlink:stop"
              ],
              "children": {
                "CONT_INIT": {
                  "id": "CONT_INIT",
                  "label": "连续初始",
                  "type": "atomic",
                  "level": 3,
                  "entryActions": [
                    "preset:continuous_idle",
                    "anim:laserBlink:start"
                  ],
                  "display": {
                    "expects": [
                      "MAX/MIN图标",
                      "Line2~4=-----"
                    ]
                  }
                },
                "CONT_MEASURING": {
                  "id": "CONT_MEASURING",
                  "label": "连续测量中",
                  "type": "atomic",
                  "level": 3,
                  "description": "自动循环测量，更新MAX/MIN",
                  "entryActions": [
                    "assign:line4_data = distance",
                    "if:distance > max_data then set:max_data = distance",
                    "if:distance < min_data || min_data < 0 then set:min_data = distance",
                    "comp:setValue:Line2:${max_data}",
                    "comp:setValue:Line3:${min_data}",
                    "comp:setValue:Line4:${line4_data}"
                  ],
                  "display": {
                    "preset": "continuous_measuring",
                    "expects": [
                      "Line2=MAX",
                      "Line3=MIN",
                      "Line4=当前"
                    ]
                  }
                }
              }
            },
            "SETTINGS": {
              "id": "SETTINGS",
              "label": "设置",
              "type": "compound",
              "level": 2,
              "initial": "BASE_SELECT",
              "description": "系统设置",
              "children": {
                "BASE_SELECT": {
                  "id": "BASE_SELECT",
                  "label": "基准选择",
                  "type": "compound",
                  "level": 3,
                  "children": {
                    "BASE_BACK": {
                      "id": "BASE_BACK",
                      "label": "后基准",
                      "type": "atomic",
                      "level": 4,
                      "entryActions": [
                        "assign:base_back = true"
                      ],
                      "display": {
                        "expects": [
                          "后基准图标"
                        ]
                      }
                    },
                    "BASE_FRONT": {
                      "id": "BASE_FRONT",
                      "label": "前基准",
                      "type": "atomic",
                      "level": 4,
                      "entryActions": [
                        "assign:base_back = false"
                      ],
                      "display": {
                        "expects": [
                          "前基准图标"
                        ]
                      }
                    }
                  }
                },
                "BEEP_SETTING": {
                  "id": "BEEP_SETTING",
                  "label": "蜂鸣器设置",
                  "type": "compound",
                  "level": 3,
                  "children": {
                    "BEEP_ON": {
                      "id": "BEEP_ON",
                      "label": "蜂鸣器开",
                      "type": "atomic",
                      "level": 4,
                      "entryActions": [
                        "assign:beep_enable = true"
                      ],
                      "display": {
                        "expects": [
                          "蜂鸣器图标亮"
                        ]
                      }
                    },
                    "BEEP_OFF": {
                      "id": "BEEP_OFF",
                      "label": "蜂鸣器关",
                      "type": "atomic",
                      "level": 4,
                      "entryActions": [
                        "assign:beep_enable = false"
                      ],
                      "display": {
                        "expects": [
                          "蜂鸣器图标灭"
                        ]
                      }
                    }
                  }
                },
                "BACKLIGHT_SETTING": {
                  "id": "BACKLIGHT_SETTING",
                  "label": "背光设置",
                  "type": "compound",
                  "level": 3,
                  "children": {
                    "BL_ON": {
                      "id": "BL_ON",
                      "label": "背光开",
                      "type": "atomic",
                      "level": 4,
                      "entryActions": [
                        "assign:backlight_on = true"
                      ]
                    },
                    "BL_OFF": {
                      "id": "BL_OFF",
                      "label": "背光关",
                      "type": "atomic",
                      "level": 4,
                      "entryActions": [
                        "assign:backlight_on = false"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
