{
  "id": "gd303_pt",
  "name": "GD303-PT",
  "model_pattern": "^(GD303-PT|gd303-pt|GD303_PT|gd303_pt)$",
  "default_workflow": "slipway_calibration",
  "version": "1.0",
  "frame_format": {
    "header": "AA",
    "direction": {
      "send": "EE",
      "recv": "FE"
    },
    "footer": "BB FF",
    "checksum": "XOR"
  },
  "commands": {
    "laser_on": {
      "code": "F0",
      "name": "开启激光",
      "icon": "🟢",
      "category": "control",
      "timeout": 500,
      "retry": 3,
      "send_params": [
        {"name": "model", "type": "uint8", "label": "型号", "default": 0},
        {"name": "direction", "type": "uint8", "label": "方向", "default": 0}
      ],
      "recv_params": [
        {"name": "error", "type": "uint8"},
        {"name": "model", "type": "uint8"},
        {"name": "direction", "type": "uint8"}
      ]
    },
    "laser_off": {
      "code": "F6",
      "name": "关闭激光",
      "icon": "🔴",
      "category": "control",
      "timeout": 500,
      "retry": 1,
      "send_params": [],
      "recv_params": [{"name": "error", "type": "uint8"}]
    },
    "calibrate_p1": {
      "code": "F1",
      "name": "标定位置1",
      "icon": "🎯",
      "category": "calibration",
      "timeout": 50000,
      "retry": 1,
      "send_params": [{"name": "distance", "type": "uint32", "label": "距离(mm)", "default": 5000}],
      "recv_params": [{"name": "error", "type": "uint8"}]
    },
    "calibrate_p2": {
      "code": "F2",
      "name": "标定位置2",
      "icon": "🎯",
      "category": "calibration",
      "timeout": 3000,
      "retry": 1,
      "send_params": [{"name": "distance", "type": "uint32", "label": "距离(mm)", "default": 20000}],
      "recv_params": [{"name": "error", "type": "uint8"}]
    },
    "calibrate_p3": {
      "code": "F3",
      "name": "标定位置3",
      "icon": "🎯",
      "category": "calibration",
      "timeout": 3000,
      "retry": 1,
      "send_params": [{"name": "distance", "type": "uint32", "label": "距离(mm)", "default": 25000}],
      "recv_params": [{"name": "error", "type": "uint8"}]
    },
    "measure": {
      "code": "FB",
      "name": "测量距离",
      "icon": "📏",
      "category": "measure",
      "timeout": 2000,
      "retry": 1,
      "send_params": [],
      "recv_params": [
        {"name": "error", "type": "uint8"},
        {"name": "distance", "type": "uint32_be", "unit": "mm"}
      ]
    },
    "laser_blink": {
      "code": "FA",
      "name": "激光闪烁",
      "icon": "💡",
      "category": "control",
      "timeout": 500,
      "retry": 1,
      "send_params": [],
      "recv_params": [{"name": "error", "type": "uint8"}]
    },
    "get_info": {
      "code": "F7",
      "name": "获取设备信息",
      "icon": "ℹ️",
      "category": "info",
      "timeout": 500,
      "retry": 1,
      "send_params": [],
      "recv_params": [
        {"name": "device_id", "type": "uint32"},
        {"name": "hw_version", "type": "uint16"},
        {"name": "sw_version", "type": "uint16"},
        {"name": "bl_version", "type": "uint16"},
        {"name": "reserved", "type": "uint16"},
        {"name": "model", "type": "string16"},
        {"name": "flash_size", "type": "uint32"},
        {"name": "app_start", "type": "uint32"},
        {"name": "app_max_size", "type": "uint32"},
        {"name": "app_actual_size", "type": "uint32"},
        {"name": "app_crc", "type": "uint32"}
      ]
    },
    "heartbeat": {
      "code": "F8",
      "name": "心跳查询",
      "icon": "💓",
      "category": "info",
      "timeout": 300,
      "retry": 1,
      "send_params": [],
      "recv_params": [
        {"name": "error", "type": "uint8"},
        {"name": "status", "type": "uint8"}
      ]
    },
    "auto_shutdown": {
      "code": "F9",
      "name": "自动关机",
      "icon": "⏻",
      "category": "control",
      "timeout": 500,
      "retry": 1,
      "send_params": [{"name": "delay", "type": "uint16_be", "default": 10, "unit": "秒"}],
      "recv_params": [
        {"name": "error", "type": "uint8"},
        {"name": "delay_set", "type": "uint16_be"}
      ]
    },
    "diag_status": {
      "code": "E0",
      "name": "诊断状态",
      "icon": "🔍",
      "category": "diagnostic",
      "timeout": 500,
      "retry": 1,
      "send_params": [],
      "recv_params": [
        {"name": "error", "type": "uint8"},
        {"name": "sys_err", "type": "uint16_be", "label": "系统错误码"},
        {"name": "phase_cal", "type": "uint8", "label": "相位校准状态"},
        {"name": "speed_cal", "type": "uint8", "label": "光速校准"},
        {"name": "hw_status", "type": "uint8", "label": "硬件状态"},
        {"name": "apdwork_x100", "type": "uint16_be", "label": "apdwork*100"},
        {"name": "speed_num", "type": "int8", "label": "校准次数"}
      ]
    }
  },
  "workflows": [
    {
      "id": "slipway_calibration",
      "name": "滑台三点标定",
      "icon": "🎯",
      "description": "5m/20m/25m三点标定",
      "steps": [
        {"action": "command", "cmd": "laser_on", "params": {"model": 0, "direction": 0}},
        {"action": "delay", "ms": 800},
        {"action": "move_slipway", "position": 5000, "timeout": 60000},
        {"action": "command", "cmd": "calibrate_p1", "params": {"distance": 5000}},
        {"action": "move_slipway", "position": 20000, "timeout": 90000},
        {"action": "command", "cmd": "calibrate_p2", "params": {"distance": 20000}},
        {"action": "move_slipway", "position": 25000, "timeout": 90000},
        {"action": "command", "cmd": "calibrate_p3", "params": {"distance": 25000}},
        {"action": "command", "cmd": "laser_off", "params": {}},
        {"action": "notify", "message": "三点标定完成"}
      ]
    }
  ],
  "params": {
    "laser_on": {"model": 0, "direction": 0},
    "calibrate_p1": {"distance": 5000},
    "calibrate_p2": {"distance": 20000},
    "calibrate_p3": {"distance": 25000}
  }
}
