  "workflows": [
    {
      "id": "slipway_calibration",
      "name": "滑台三点标定",
      "icon": "🎯",
      "description": "5m/20m/25m三点标定",
      "steps": [
        {
          "action": "command",
          "cmd": "laser_on",
          "params": {
            "model": 0,
            "direction": 0
          }
        },
        {
          "action": "delay",
          "ms": 800
        },
        {
          "action": "move_slipway",
          "position": 5000,
          "timeout": 60000
        },
        {
          "action": "command",
          "cmd": "calibrate_p1",
          "params": {
            "distance": 5000
          }
        },
        {
          "action": "move_slipway",
          "position": 20000,
          "timeout": 90000
        },
        {
          "action": "command",
          "cmd": "calibrate_p2",
          "params": {
            "distance": 20000
          }
        },
        {
          "action": "move_slipway",
          "position": 25000,
          "timeout": 90000
        },
        {
          "action": "command",
          "cmd": "calibrate_p3",
          "params": {
            "distance": 25000
          }
        },
        {
          "action": "command",
          "cmd": "laser_off",
          "params": {}
        },
        {
          "action": "notify",
          "message": "三点标定完成"
        }
      ]
    },
    {
      "id": "slipway_multi_calibration",
      "name": "滑台联动标定",
      "icon": "🔄",
      "description": "滑台+转靶联动",
      "steps": [
        {
          "action": "move_rotary",
          "position": "10%",
          "timeout": 30000
        },
        {
          "action": "command",
          "cmd": "laser_on",
          "params": {
            "model": 0,
            "direction": 0
          }
        },
        {
          "action": "delay",
          "ms": 800
        },
        {
          "action": "move_slipway",
          "position": 5000,
          "timeout": 60000
        },
        {
          "action": "command",
          "cmd": "calibrate_p1",
          "params": {
            "distance": 5000
          }
        },
        {
          "action": "move_rotary",
          "position": "90%",
          "timeout": 30000
        },
        {
          "action": "move_slipway",
          "position": 20000,
          "timeout": 90000
        },
        {
          "action": "command",
          "cmd": "calibrate_p2",
          "params": {
            "distance": 20000
          }
        },
        {
          "action": "move_slipway",
          "position": 25000,
          "timeout": 90000
        },
        {
          "action": "command",
          "cmd": "calibrate_p3",
          "params": {
            "distance": 25000
          }
        },
        {
          "action": "command",
          "cmd": "laser_off",
          "params": {}
        },
        {
          "action": "notify",
          "message": "联动标定完成"
        }
      ]
    }
  ],
  "params": {
    "laser_on": {
      "model": 0,
      "direction": 0
    },
    "calibrate_p1": {
      "distance": 5000
    },
    "calibrate_p2": {
      "distance": 20000
    },
    "calibrate_p3": {
      "distance": 25000
    }
  },
  "id": "mini30",
  "name": "MINI30",
  "model_pattern": "^(MINI30|mini30|mini-30|GD303-MINI|gd303-mini|GD303_MINI)$",
  "default_workflow": "slipway_calibration"
}
