        {
          "name": "model",
          "type": "uint8",
          "label": "型号",
          "default": 0
        },
        {
          "name": "direction",
          "type": "uint8",
          "label": "方向",
          "default": 0
        }
      ],
      "recv_params": [
        {
          "name": "error",
          "type": "uint8"
        },
        {
          "name": "model",
          "type": "uint8"
        },
        {
          "name": "direction",
          "type": "uint8"
        }
      ]
    },
