{
  "version": "1.0",
  "frame_format": {
    "header": "AA",
    "direction": {
      "send": "EE",
      "recv": "FE"
    },
    "footer": "BB FF",
    "checksum": "XOR"
  },
  "commands": {
    "event_inject": {
      "code": "D0",
      "name": "事件注入(通用)",
      "icon": "🎮",
      "category": "ui_test",
      "description": "统一的事件注入命令，替代 B3-C0 等分散命令。参数: evt_type(事件类型), action(动作ID), trigger(触发类型), param(扩展参数)",
      "timeout": 500,
      "retry": 1,
      "response_type": "text",
      "send_params": [
        {
          "name": "evt_type",
          "type": "uint8",
          "label": "事件类型",
          "default": 0,
          "enum": {
            "0": "INPUT(按键)",
            "1": "UI_SET(UI设置)",
            "2": "SIM_MEASURE(模拟测量)",
            "3": "QUERY(状态查询)",
            "4": "SYSTEM(系统控制)"
          }
        },
        {
          "name": "action",
          "type": "uint8",
          "label": "动作ID",
          "default": 1,
          "description": "INPUT_ACTION_xxx 枚举值，参见 actions.json"
        },
        {
          "name": "trigger",
          "type": "uint8",
          "label": "触发类型",
          "default": 0,
          "enum": {
            "0": "SHORT(短按)",
            "1": "LONG(长按)",
            "2": "SUPER_LONG(超长按)",
            "4": "RELEASE(释放)"
          }
        },
        {
          "name": "param",
          "type": "uint8",
          "label": "扩展参数",
          "default": 0
        }
      ],
      "recv_params": [
        {
          "name": "evt_type",
          "type": "string",
          "label": "事件类型"
        },
        {
          "name": "action",
          "type": "string",
          "label": "动作ID"
        },
        {
          "name": "error",
          "type": "string",
          "label": "错误码"
        },
        {
          "name": "mode",
          "type": "string",
          "label": "模式"
        },
        {
          "name": "unit",
          "type": "string",
          "label": "单位"
        },
        {
          "name": "step",
          "type": "string",
          "label": "步骤"
        },
        {
          "name": "laser",
          "type": "string",
          "label": "激光"
        }
      ],
      "example_response": "d0.s;t:0;a:1;e:0;m:SGL;u:m;s:0;l:0;d0.e"
    },
    "laser_on": {
      "code": "F0",
      "name": "开启激光",
      "icon": "🟢",
      "category": "control",
      "timeout": 500,
      "retry": 3,
      "send_params": [
        {
          "name": "model",
          "type": "uint8",
          "label": "型号",
          "enum": {
            "0": "mini-30h",
            "1": "低价两键",
            "2": "双头"
          }
        },
        {
          "name": "direction",
          "type": "uint8",
          "label": "方向",
          "enum": {
            "0": "前头激光",
            "1": "后头激光"
          }
        }
      ],
      "recv_params": [
        {
          "name": "error",
          "type": "uint8"
        },
        {
          "name": "model",
          "type": "uint8"
        },
        {
          "name": "direction",
